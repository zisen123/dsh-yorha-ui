{
  "name": "dsh-plugin-yorha-ui",
  "version": "0.2.1",
  "description": "NieR:Automata (YoRHa) industrial terminal theme plugin for the DeepSeek Harness Web GUI",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "theme",
    "yorha",
    "nier-automata"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrmo072/dsh-yorha-ui.git"
  },
  "homepage": "https://github.com/Mrmo072/dsh-yorha-ui#readme",
  "bugs": {
    "url": "https://github.com/Mrmo072/dsh-yorha-ui/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
